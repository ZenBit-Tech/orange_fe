    "@mui/material": "^7.3.2",
    "@reduxjs/toolkit": "^2.9.0",
    "@types/node": "^24.6.2",
    "@types/react-redux": "^7.1.34",
    "chart.js": "^4.5.1",
    "i18next": "^25.5.2",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.553.0",
    "react": "^19.1.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.1.1",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.63.0",
    "react-i18next": "^16.0.0",
    "react-icons": "^5.5.0",
